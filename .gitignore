__pycache__/
.venv/
.env
# 日時付きの控え (.env.bak-20260807172231 等) は完全一致では弾けない。
# 実際に未追跡のまま検出された経緯があるためワイルドカードで除外する。
.env.bak*
.env.backup*
.gemini/
# up 中の退避 (.docker-compose.scale.yml.prev) も含めて除外する。
.docker-compose.scale.yml*
plugins.yml
repos/
plugins/*/
!plugins/.gitkeep
projects/*
!projects/.gitkeep
.env.sources.yml
.cache/

# 暗号化した機密の保存先 (PLAN35)。暗号文とはいえリポジトリには載せない。
secrets/

# クロスレビュー (ndf:cross-review) の作業生成物
.cross_review/
gh-payload.json
# gh api --input 用の一時ペイロード。gh-payload.json 以外の名前でも取り込まない。
/payload.json
# レビュー中に採取した差分ダンプ (pr119.diff 等) を誤ってコミットしないため。
*.diff

# 開発用の作業ツリー
.worktrees/
