 def _auto_snapshot() -> None:
     """デプロイ前の自動スナップショット (差分世代数ベース世代管理)。
 
     失敗してもデプロイは続行する (warning のみ)。DEVBASE_ROOT 未設定なら no-op。
     """
     devbase_root = os.environ.get('DEVBASE_ROOT')
     if not devbase_root:
         return
