#compdef devbase

# zsh completion for devbase

_devbase_plugin_names() {
    local devbase_root plugin_dir
    devbase_root="${DEVBASE_ROOT:-$(dirname "$(dirname "$(command -v devbase 2>/dev/null)")" 2>/dev/null)}"
    plugin_dir="${devbase_root}/plugins"
    if [[ -d "$plugin_dir" ]]; then
        local -a plugins
        plugins=(${plugin_dir}/*(N:t))
        _describe 'plugin' plugins
    fi
}

_devbase_project_names() {
    local devbase_root projects_dir
    devbase_root="${DEVBASE_ROOT:-$(dirname "$(dirname "$(command -v devbase 2>/dev/null)")" 2>/dev/null)}"
    projects_dir="${devbase_root}/projects"
    if [[ -d "$projects_dir" ]]; then
        local -a projects
        # 実ディレクトリ + symlink 先がディレクトリのものを対象
        # (N: nullglob, -: symlink 追従, /: ディレクトリのみ, :t: tail)。
        projects=(${projects_dir}/*(N-/:t))
        _describe 'project' projects
    fi
}

_devbase_repo_names() {
    local devbase_root yml
    devbase_root="${DEVBASE_ROOT:-$(dirname "$(dirname "$(command -v devbase 2>/dev/null)")" 2>/dev/null)}"
    yml="${devbase_root}/plugins.yml"
    if [[ -f "$yml" ]] && (( $+commands[python3] )); then
        local -a repos
        repos=($(python3 -c "
import yaml, sys
try:
    d = yaml.safe_load(open('$yml'))
    print(' '.join(r['name'] for r in (d or {}).get('repositories', [])))
except Exception:
    pass
" 2>/dev/null))
        _describe 'repository' repos
    fi
}

# 選んだサブコマンドの語を先頭 (コマンド名の位置) に置いてから _arguments を呼ぶ。
# _arguments は words[1] だけをコマンド名として飛ばすため、そのまま呼ぶと
# `devbase up <TAB>` の `up` が 1 番目の引数に数えられ、'1:name' が利用者の
# 引数を指さない (#450)。$1 はサブコマンドの語の位置 (devbase up → 2、
# devbase project up → 3)。words と CURRENT は補完の特別な変数で、関数を
# 抜けると元の値に戻る。
_devbase_arguments() {
    local depth=$1
    shift
    words=("${(@)words[depth,-1]}")
    (( CURRENT -= depth - 1 ))
    _arguments "$@"
}

_devbase() {
    local -a commands project_subcommands container_subcommands env_subcommands
    local -a plugin_subcommands repo_subcommands snapshot_subcommands

    commands=(
        'init:Initialize devbase environment'
        'status:Show overall status'
        'shell-rc:Print shell RC file path (for source ...)'
        'project:Manage projects (CWD-independent)'
        'container:Manage containers (deprecated: use project)'
        'ct:Manage containers (deprecated alias)'
        'env:Manage environment variables'
        'plugin:Manage plugins'
        'pl:Manage plugins (alias)'
        'snapshot:Manage snapshots'
        'ss:Manage snapshots (alias)'
        'up:Start containers (shortcut)'
        'down:Stop containers (shortcut)'
        'login:Login to container (shortcut)'
        'build:Build container images'
        'rebuild:Rebuild images without cache (shortcut)'
        'ps:Show container status (shortcut)'
        'scale:Scale containers online (shortcut)'
        'open:Open the editor without restarting (shortcut)'
        'list:List projects (shortcut)'
        'help:Show help'
    )

    project_subcommands=(
        'up:Start containers'
        'down:Stop and remove containers'
        'ps:Show container status'
        'login:Login to container'
        'logs:Show container logs'
        'scale:Scale containers online'
        'build:Build container images'
        'rebuild:Rebuild images without cache (docker compose build --no-cache)'
        'list:List projects (NAME / PLUGIN / STATUS)'
        'profile:Start / stop compose profile services'
        'open:Open the editor attached to the dev container'
        'post-start:Redo the post-start steps on running instances'
    )

    container_subcommands=(
        'up:Start containers'
        'down:Stop and remove containers'
        'ps:Show container status'
        'login:Login to container'
        'logs:Show container logs'
        'scale:Scale containers online'
        'build:Build container images'
        'rebuild:Rebuild images without cache (docker compose build --no-cache)'
        'profile:Start / stop compose profile services'
        'open:Open the editor attached to the dev container'
    )

    env_subcommands=(
        'init:Initial setup (interactive)'
        'sync:Resync credentials from sources'
        'list:List variables'
        'set:Set a variable'
        'get:Get a variable'
        'delete:Delete a variable'
        'edit:Open .env in editor'
        'project:Setup project-specific variables'
        'export:Export .env files as an encrypted bundle (age)'
        'import:Import .env bundle (age decrypt + merge)'
        'keygen:Generate the devbase age key used by the secret store'
        'exec:Run a command with the decrypted secrets in its environment'
        'encrypt:Move plaintext settings into the encrypted store'
        'decrypt:Move encrypted settings back to plaintext'
        'rekey:Change who can decrypt the secrets and re-encrypt them'
        'doctor:Check for leftover plaintext secrets and ignore-rule gaps'
    )

    plugin_subcommands=(
        'list:List plugins'
        'install:Install a plugin'
        'uninstall:Uninstall a plugin'
        'update:Update plugin(s)'
        'info:Show plugin details'
        'sync:Resync project symlinks'
        'repo:Manage plugin repositories'
    )

    repo_subcommands=(
        'add:Register a repository'
        'remove:Unregister a repository'
        'list:List registered repositories'
        'refresh:Refresh repository plugin list'
    )

    snapshot_subcommands=(
        'create:Create a snapshot'
        'list:List snapshots'
        'restore:Restore from a snapshot'
        'copy:Copy a snapshot'
        'delete:Delete a snapshot'
        'rotate:Rotate old snapshots'
    )

    # --context NAME を取るサブコマンドは、どれも値を補完しない --context を出す (#435)。
    case "$words[2]" in
        login)
            _devbase_arguments 2 \
                '--context[Docker context]:context:' \
                '1:index:(1 2)'
            ;;
        build)
            _devbase_arguments 2 \
                '--context[Docker context]:context:' \
                '1:image:'
            ;;
        # トップレベルシノニム: up/down/ps/scale/rebuild は [name] を取るためプロジェクト名を補完。
        up|down|rebuild)
            _devbase_arguments 2 \
                '--context[Docker context]:context:' \
                '1:name:_devbase_project_names'
            ;;
        ps)
            _devbase_arguments 2 \
                '--all[Show all containers]' \
                '-a[Show all containers]' \
                '--context[Docker context]:context:' \
                '1:name:_devbase_project_names'
            ;;
        scale)
            _devbase_arguments 2 \
                '--context[Docker context]:context:' \
                '1:name:_devbase_project_names'
            ;;
        open)
            _devbase_arguments 2 \
                '--open-index[Container index to open]:index:' \
                '--context[Docker context]:context:' \
                '1:name:_devbase_project_names'
            ;;
        list)
            _devbase_arguments 2 \
                '--no-interactive[Just print the table without interactive selection]' \
                '--plain[Just print the table without interactive selection]' \
                '-P[Just print the table without interactive selection]' \
                '--interactive[(compat) interactive selection, default]' \
                '-i[(compat) interactive selection, default]'
            ;;
        project)
            case "$words[3]" in
                up|down|rebuild)
                    _devbase_arguments 3 \
                        '--context[Docker context]:context:' \
                        '1:name:_devbase_project_names'
                    ;;
                login)
                    _devbase_arguments 3 \
                        '--context[Docker context]:context:' \
                        '1:index:(1 2)'
                    ;;
                scale)
                    _devbase_arguments 3 \
                        '--context[Docker context]:context:' \
                        '1:name:_devbase_project_names'
                    ;;
                ps)
                    # name (positional) と -a フラグを _arguments に統合。
                    # name 入力済みなら positional は補完されず、フラグのみ残る
                    # (bash 側の排他分岐と挙動を揃える)。
                    _devbase_arguments 3 \
                        '--all[Show all containers]' \
                        '-a[Show all containers]' \
                        '--context[Docker context]:context:' \
                        '1:name:_devbase_project_names'
                    ;;
                logs)
                    _devbase_arguments 3 \
                        '--follow[Follow log output]' \
                        '-f[Follow log output]' \
                        '--tail[Number of lines]:lines:' \
                        '--context[Docker context]:context:' \
                        '1:name:_devbase_project_names'
                    ;;
                build)
                    _devbase_arguments 3 \
                        '--context[Docker context]:context:' \
                        '1:image:'
                    ;;
                list)
                    _devbase_arguments 3 \
                        '--no-interactive[Just print the table without interactive selection]' \
                        '--plain[Just print the table without interactive selection]' \
                        '-P[Just print the table without interactive selection]' \
                        '--interactive[(compat) interactive selection, default]' \
                        '-i[(compat) interactive selection, default]'
                    ;;
                profile)
                    case "$words[4]" in
                        up|down|list)
                            _devbase_arguments 3 \
                                '--context[Docker context]:context:' \
                                '*:profile:'
                            ;;
                        *)
                            _values 'operation' up down list
                            ;;
                    esac
                    ;;
                open)
                    _devbase_arguments 3 \
                        '--open-index[Container index to open]:index:' \
                        '--context[Docker context]:context:' \
                        '1:name:_devbase_project_names'
                    ;;
                post-start)
                    _devbase_arguments 3 \
                        '--context[Docker context]:context:' \
                        '1:name:_devbase_project_names'
                    ;;
                *)
                    _describe -t project-commands 'project command' project_subcommands
                    ;;
            esac
            ;;
        container|ct)
            case "$words[3]" in
                up|down|rebuild)
                    _devbase_arguments 3 '--context[Docker context]:context:'
                    ;;
                login)
                    _devbase_arguments 3 \
                        '--context[Docker context]:context:' \
                        '1:index:(1 2)'
                    ;;
                scale)
                    _devbase_arguments 3 \
                        '--context[Docker context]:context:' \
                        '1:new_scale:(1 2 3 4 5)'
                    ;;
                ps)
                    _devbase_arguments 3 \
                        '--all[Show all containers]' \
                        '-a[Show all containers]' \
                        '--context[Docker context]:context:'
                    ;;
                logs)
                    _devbase_arguments 3 \
                        '--follow[Follow log output]' \
                        '-f[Follow log output]' \
                        '--tail[Number of lines]:lines:' \
                        '--context[Docker context]:context:'
                    ;;
                build)
                    _devbase_arguments 3 \
                        '--context[Docker context]:context:' \
                        '1:image:'
                    ;;
                profile)
                    case "$words[4]" in
                        up|down|list)
                            _devbase_arguments 3 \
                                '--context[Docker context]:context:' \
                                '*:profile:'
                            ;;
                        *)
                            _values 'operation' up down list
                            ;;
                    esac
                    ;;
                open)
                    _devbase_arguments 3 \
                        '--open-index[Container index to open]:index:' \
                        '--context[Docker context]:context:'
                    ;;
                *)
                    _describe -t container-commands 'container command' container_subcommands
                    ;;
            esac
            ;;
        env)
            case "$words[3]" in
                init)
                    _devbase_arguments 3 '--reset[Reset existing config]'
                    ;;
                list)
                    _devbase_arguments 3 \
                        '--global[Show global only]' '-g[Show global only]' \
                        '--project[Show project only]' '-p[Show project only]' \
                        '--reveal[Reveal sensitive values]' '-r[Reveal sensitive values]' \
                        '--keys[Show keys only]' '-k[Show keys only]'
                    ;;
                set)
                    _devbase_arguments 3 \
                        '1:assignment:' \
                        '--project[Set in project .env]' '-p[Set in project .env]'
                    ;;
                get)
                    _devbase_arguments 3 '1:key:'
                    ;;
                delete)
                    _devbase_arguments 3 \
                        '1:key:' \
                        '--project[Delete from project .env]' '-p[Delete from project .env]'
                    ;;
                edit)
                    _devbase_arguments 3 \
                        '--project[Edit project .env]' '-p[Edit project .env]'
                    ;;
                export)
                    _devbase_arguments 3 \
                        '1:dest:_files' \
                        '*--include-project[Limit to specified project (repeatable)]:name:' \
                        '*--exclude-project[Exclude project (repeatable)]:name:' \
                        '--no-global[Exclude $DEVBASE_ROOT/.env]' \
                        '--no-metadata[Exclude $DEVBASE_ROOT/.env.sources.yml]' \
                        '*--recipient[age / OpenSSH public key (repeatable)]:key:' \
                        '--passphrase-env[Read passphrase from env var]:var:' \
                        '--passphrase-stdin[Read passphrase from stdin]' \
                        '--force-unencrypted[Write as plaintext tar.gz]' \
                        '--unsafe-allow-unencrypted-bucket[Allow uploading unencrypted tar.gz to S3 (off by default)]'
                    ;;
                import)
                    _devbase_arguments 3 \
                        '1:source:_files' \
                        '--merge[Merge strategy]:mode:(keep-existing prefer-incoming)' \
                        '--replace-keys[Replace only these keys (comma-separated)]:keys:' \
                        '--replace[Replace existing files entirely]' \
                        '--dry-run[Preview changes without writing]' \
                        '*--identity[age / OpenSSH private key file (repeatable)]:file:_files' \
                        '--passphrase-env[Read passphrase from env var]:var:' \
                        '--passphrase-stdin[Read passphrase from stdin]' \
                        '*--include-project[Limit to specified project (repeatable)]:name:' \
                        '*--exclude-project[Exclude project (repeatable)]:name:' \
                        '--no-global[Do not import $DEVBASE_ROOT/.env]' \
                        '--no-metadata[Do not import $DEVBASE_ROOT/.env.sources.yml]' \
                        '--merge-metadata[Add only new sources entries from bundle]' \
                        '--backup-dir[Override backup directory]:dir:_files -/' \
                        '--keep-last[Keep only the last N backup directories]:n:'
                    ;;
                exec)
                    _devbase_arguments 3 \
                        '--context[Docker context]:context:' \
                        '*:command:_command_names -e'
                    ;;
                token)
                    _devbase_arguments 3 '--context[Docker context]:context:'
                    ;;
                encrypt|decrypt)
                    _devbase_arguments 3 \
                        '*--project[Limit to the specified project (repeatable)]:name:' \
                        '--dry-run[Show what would change without writing]' \
                        '--yes[Skip the confirmation prompt]' '-y[Skip the confirmation prompt]'
                    ;;
                rekey)
                    _devbase_arguments 3 \
                        '*--add-recipient[Public key to add (repeatable)]:key:' \
                        '*--remove-recipient[Public key to remove (repeatable)]:key:' \
                        '--dry-run[Show what would change without writing]' \
                        '--yes[Skip the confirmation prompt]' '-y[Skip the confirmation prompt]'
                    ;;
                keygen)
                    _devbase_arguments 3 \
                        '--force[Overwrite an existing key]' \
                        '--yes[Skip the confirmation prompt for --force]' '-y[Skip the confirmation prompt for --force]'
                    ;;
                *)
                    _describe -t env-commands 'env command' env_subcommands
                    ;;
            esac
            ;;
        plugin|pl)
            case "$words[3]" in
                list)
                    _devbase_arguments 3 '--available[Show available plugins from registered repositories]'
                    ;;
                install)
                    _devbase_arguments 3 \
                        '1:source:_files' \
                        '--link[Install as symlink for local development]' \
                        '--all[Install all plugins from repository]'
                    ;;
                uninstall|update|info)
                    _devbase_plugin_names
                    ;;
                repo)
                    case "$words[4]" in
                        add)
                            _devbase_arguments 4 \
                                '1:url:_urls' \
                                '--name[Custom name for the repository]:name:'
                            ;;
                        remove|refresh)
                            _devbase_repo_names
                            ;;
                        list)
                            ;;
                        *)
                            _describe -t repo-commands 'repo command' repo_subcommands
                            ;;
                    esac
                    ;;
                *)
                    _describe -t plugin-commands 'plugin command' plugin_subcommands
                    ;;
            esac
            ;;
        snapshot|ss)
            case "$words[3]" in
                create)
                    _devbase_arguments 3 \
                        '--name[Snapshot name]:name:' \
                        '--full[Force full backup]'
                    ;;
                restore)
                    _devbase_arguments 3 \
                        '1:name:' \
                        '--point[Restore up to incr-N only]:n:'
                    ;;
                copy)
                    _devbase_arguments 3 '1:name:' '2:new_name:'
                    ;;
                delete)
                    _devbase_arguments 3 '1:name:'
                    ;;
                rotate)
                    _devbase_arguments 3 '--keep[Generations to keep]:n:'
                    ;;
                *)
                    _describe -t snapshot-commands 'snapshot command' snapshot_subcommands
                    ;;
            esac
            ;;
        *)
            _describe -t commands 'devbase command' commands
            ;;
    esac
}

_devbase "$@"
